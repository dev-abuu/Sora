# Required for contact and Join Team forms to send email.
# Create a free account at https://resend.com and add the API key here
# and in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=

# Optional. Must be a sender on a domain you have verified in Resend.
# Until the domain is verified, Resend’s onboarding address can be used.
RESEND_FROM_EMAIL=Sora Spa Collective <noreply@soraspacollective.co.uk>

# Optional. Defaults to Info@soraspacollective.co.uk
CONTACT_TO_EMAIL=Info@soraspacollective.co.uk
